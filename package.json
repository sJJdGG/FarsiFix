{
  "name": "farsifix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview:local": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ox": "oxlint --type-aware --react-plugin --import-plugin --tsconfig tsconfig.app.json src",
    "lint:all": "npm run lint && npm run lint:ox",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "view": "node scripts/view.mjs"
  },
  "dependencies": {
    "comlink": "latest",
    "jszip": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@tailwindcss/postcss": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "oxlint": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tailwindcss-rtl": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-terminal": "latest",
    "vitest": "latest"
  }
}
