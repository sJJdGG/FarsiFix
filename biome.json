{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": { "parser": { "tailwindDirectives": true } },
  "files": {
    "includes": [
      "src/**",
      "e2e/**",
      "scripts/**",
      "tests/**",
      "*.ts",
      "*.tsx",
      "*.js",
      "*.mjs",
      "*.cjs",
      "*.json",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/test-results",
      "!!**/.playwright-cli",
      "!!**/output",
      "!!**/coverage",
      "!!**/package-lock.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
